# Dev server port (default: 3000)
PORT=3001
OPERATOR_TOKEN=dev-to...e-me
DEFAULT_TENANT_ID=01JDEFAULT0000000000000000
# Optional: path to agency-agents repo (defaults to ~/projects/agency-agents)
# AGENCY_AGENTS_PATH=/path/to/agency-agents

# Maton API — Gmail, Calendar, Drive, Sheets, HubSpot
# Sign up at https://maton.ai, connect Google, get key at https://ctrl.maton.ai
# MATON_API_KEY=your-key-here

# Attio CRM — create API key at https://app.attio.com/settings/api-keys
# ATTIO_API_KEY=your-key-here

# Telegram Bot — create via @BotFather, paste token here
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Agent Runtime — which CLI executes agent prompts (default: claude)
# Options: claude, hermes, openclaw, codex
# AGENT_RUNTIME=claude

# Scout tools
# Exa semantic web search — get key at dashboard.exa.ai
# EXA_API_KEY=your-key-here
# Hunter.io email finder — get key at hunter.io
# HUNTER_API_KEY=your-key-here
# Apollo.io people/company search — get key at apollo.io
# APOLLO_API_KEY=your-key-here
# GitHub API token — optional, raises rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_your-token-here

# Chief of Staff runtime override
# Options: codex, claude, direct-api, antbase
# CHIEF_OF_STAFF_RUNTIME=codex
# CHIEF_OF_STAFF_CODEX_MODEL=gpt-5.4
# CHIEF_OF_STAFF_CODEX_SANDBOX=read-only
